# Copia este archivo a .env y rellena tus valores. NO subas .env a Git.
# Todos los valores de abajo son ficticios.

# --- Backend (secretos / ejecución) ---
OPENROUTER_API_KEY=sk-or-v1-PON_AQUI_TU_CLAVE
# Modelos GRATUITOS (":free") separados por comas: el primero es el principal y los
# siguientes son respaldo si el principal está limitado (429). El backend desactiva el
# razonamiento, porque si no estos modelos gastan los tokens "pensando" y devuelven JSON
# incompleto (error 502 "No se pudo generar el test").
OPENROUTER_MODEL=apodex/apodex-1.1-mini:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free
OPENROUTER_TIMEOUT_SECONDS=40

# Clerk (instancia de desarrollo). La secreta solo vive en el servidor.
CLERK_SECRET_KEY=sk_test_PON_AQUI_TU_CLAVE
# Orígenes exactos de la SPA aceptados en el claim "azp" del token (sin barra final).
# Local: Vite (5173) y Docker (8080). Vercel: https://testia.vercel.app. EC2: http://IP_PUBLICA
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:8080

# --- Frontend (público, entra en el bundle en compilación) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_PON_AQUI_TU_CLAVE
